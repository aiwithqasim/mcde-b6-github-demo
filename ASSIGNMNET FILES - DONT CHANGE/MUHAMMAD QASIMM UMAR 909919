---JOINS---

SELECT 
    p.product_name, 
    b.brand_name, 
    c.category_name
FROM production.products AS p
INNER JOIN production.brands AS b 
    ON p.brand_id = b.brand_id
INNER JOIN production.categories AS c 
    ON p.category_id = c.category_id;

    SELECT 
    c.first_name + ' ' + c.last_name AS full_name, 
    o.order_date, 
    o.order_status
FROM sales.orders AS o
INNER JOIN sales.customers AS c 
    ON o.customer_id = c.customer_id;

    SELECT 
    p.product_name, 
    oi.quantity, 
    oi.list_price, 
    oi.discount
FROM sales.order_items AS oi
INNER JOIN production.products AS p 
    ON oi.product_id = p.product_id;

SELECT 
    s.first_name + ' ' + s.last_name AS staff_full_name, 
    st.store_name
FROM sales.staffs AS s
INNER JOIN sales.stores AS st 
    ON s.store_id = st.store_id;


    SELECT 
    e.first_name + ' ' + e.last_name AS staff_full_name, 
    m.first_name + ' ' + m.last_name AS manager_full_name
FROM sales.staffs AS e
LEFT JOIN sales.staffs AS m 
    ON e.manager_id = m.staff_id;

    SELECT 
    st.store_name, 
    p.product_name, 
    s.quantity
FROM production.stocks AS s
INNER JOIN sales.stores AS st 
    ON s.store_id = st.store_id
INNER JOIN production.products AS p 
    ON s.product_id = p.product_id
WHERE s.quantity > 0;


SELECT 
    c.first_name + ' ' + c.last_name AS customer_name, 
    o.order_date
FROM sales.customers AS c
INNER JOIN sales.orders AS o 
    ON c.customer_id = o.customer_id;


    SELECT 
    c.first_name + ' ' + c.last_name AS customer_name, 
    o.order_id, 
    o.order_date
FROM sales.customers AS c
LEFT JOIN sales.orders AS o 
    ON c.customer_id = o.customer_id;
