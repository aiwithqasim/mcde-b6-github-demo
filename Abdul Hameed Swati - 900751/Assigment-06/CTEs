SELECT store_id, COUNT(*) AS order_count
INTO #temp_store_counts
FROM sales.orders
GROUP BY store_id;

SELECT a.store_id, a.order_count, b.order_count AS comparison_count
FROM #temp_store_counts a
INNER JOIN #temp_store_counts b ON a.store_id = b.store_id;

DROP TABLE #temp_store_counts;
